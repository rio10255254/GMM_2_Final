#!/usr/bin/env bash
# Pre-commit hook: run the official standard health check before allowing commit.
#
# Install: python Tools/install_hooks.py
# Skip once (emergency): git commit --no-verify
# Uninstall: rm .git/hooks/pre-commit

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[pre-commit] running project control center standard health..."

if ! python Tools/project_control_center.py --view health --health-level standard > /tmp/project_control_center_health.log 2>&1; then
    echo "[pre-commit] FAILED — standard health reported problems:"
    echo ""
    cat /tmp/project_control_center_health.log
    echo ""
    echo "[pre-commit] Fix the errors above, or bypass with: git commit --no-verify"
    exit 1
fi

# Standard health exited 0. Show the final summary lines for quick visibility.
if grep -q "Health:" /tmp/project_control_center_health.log; then
    tail -8 /tmp/project_control_center_health.log
fi

echo "[pre-commit] OK"
exit 0
